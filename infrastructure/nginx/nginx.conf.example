# EXAMPLE reverse proxy for the AWS EC2 deployment target (Option A). Not wired into docker-compose.yml
# (that file is development-only). Copy to /etc/nginx/sites-available/erp.conf, replace the placeholders
# below, and provision TLS certificates (e.g. via certbot) before enabling the HTTPS server block.
#
# Terminates TLS, serves the built frontend (dist/), and reverse-proxies /api/ plus the infra endpoints
# (/health, /ready, /version) to the backend (started by PM2 via ecosystem.config.js on 127.0.0.1:4000).
# Set TRUST_PROXY=1 in the backend's environment so req.ip reflects X-Forwarded-For correctly.

# Redirect all plain HTTP to HTTPS.
server {
  listen 80;
  server_name erp.example.com;
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl http2;
  server_name erp.example.com;

  # ssl_certificate / ssl_certificate_key: provisioned outside source control (e.g. certbot / ACM).
  # ssl_certificate     /etc/letsencrypt/live/erp.example.com/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/erp.example.com/privkey.pem;

  client_max_body_size 1m;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Reverse proxy timeouts: generous enough for report/CSV export requests, bounded so a stuck
  # backend doesn't hold the nginx worker open indefinitely.
  proxy_connect_timeout 5s;
  proxy_send_timeout 30s;
  proxy_read_timeout 30s;

  location /api/ {
    proxy_pass http://127.0.0.1:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Infra endpoints (liveness/readiness/build-info) - same backend, not under /api/.
  location ~ ^/(health|ready|version)$ {
    proxy_pass http://127.0.0.1:4000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    access_log off;
  }

  # Built frontend bundle (frontend/dist after `npm run build`, or the output copied from Dockerfile.prod).
  root /var/www/erp/dist;
  index index.html;

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # SPA deep-link refresh fallback.
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache";
  }
}
