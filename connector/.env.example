# Phase 16 — Tally Connector configuration. Copy to .env and fill in. Never commit the real .env file.

# ERP cloud base URL (no trailing slash)
ERP_BASE_URL=https://erp.example.com

# Connector credential secret, issued once by an ERP admin via POST /api/v1/tally/connectors
# (Admin UI: Tally Settings -> Connectors -> Register Connector). Shown only once at creation — store it
# securely (e.g. Windows Credential Manager / a restricted-permission local file), never in source control.
TALLY_CONNECTOR_SECRET=

# How often (ms) the connector polls the ERP for claimable jobs
POLL_INTERVAL_MS=10000

# How often (ms) the connector sends a heartbeat
HEARTBEAT_INTERVAL_MS=30000

# HTTP request timeout to the ERP (ms)
REQUEST_TIMEOUT_MS=10000

# Retry/backoff for transient connector-side failures (ERP unreachable etc — NOT the job retry policy,
# which is owned and enforced server-side)
MAX_RETRIES=3
RETRY_BACKOFF_MS=2000

# Local TallyPrime connection. TALLY_MODE=mock (default) never contacts a real TallyPrime instance — use
# this until a real TallyPrime/TDL environment has been set up and verified (see
# docs/integrations/tally-connector.md "Real Tally setup requirements"). Set TALLY_MODE=http to use a real
# instance via TallyPrime's XML-over-HTTP gateway (Gateway of Tally -> F12 -> Advanced Configuration ->
# enable ODBC/HTTP server, typically port 9000).
TALLY_MODE=mock
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
TALLY_COMPANY_NAME=
TALLY_TIMEOUT_MS=10000

# Identification only (shown in the admin UI) — never personal/machine-identifying information.
CONNECTOR_NAME=unnamed-connector
CONNECTOR_VERSION=0.1.0

# Logging
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_FILE_PATH=./connector.log
