# Production image: builds the static Vite bundle, then serves it with nginx.
# Build with: docker build -f Dockerfile.prod --build-arg VITE_API_BASE_URL=/api/v1 -t erp-frontend:prod .
#
# VITE_API_BASE_URL is baked into the static bundle at build time (Vite env vars are compile-time, not
# runtime) - set it to match wherever the backend is actually reachable from the browser. The default of
# /api/v1 assumes this image sits behind a reverse proxy (see infrastructure/nginx/nginx.conf.example)
# that forwards /api/ to the backend on the same origin, which is the recommended same-origin setup.
FROM node:22-alpine AS build
WORKDIR /app
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:80/ || exit 1
