NODE_ENV=development
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/erp-platform

# JWT secrets - generate distinct, random values (min 32 chars each), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Production refuses to start if these look like placeholders or are identical to each other.
JWT_ACCESS_SECRET=change-me-dev-only-generate-a-random-32-char-secret
JWT_REFRESH_SECRET=change-me-dev-only-generate-a-different-random-32-char-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins. Wildcard "*" is rejected in production.
CORS_ORIGIN=http://localhost:5173

# Tally integration (optional until configured per-tenant)
TALLY_API_URL=
TALLY_API_KEY=

# Base64-encoded 32-byte key(s) for AES-256-GCM encryption of stored credentials (e.g. Tally password).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ENCRYPTION_KEY_PREVIOUS may hold the prior key during a rotation window; leave blank otherwise.
ENCRYPTION_KEY=change-me-dev-only-base64-32-byte-key
ENCRYPTION_KEY_PREVIOUS=

# bcrypt cost factor for password hashing
BCRYPT_COST=12

# Login lockout policy
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

LOG_LEVEL=info

# Number of trusted reverse-proxy hops in front of this app (affects req.ip used by rate limiting/audit)
TRUST_PROXY=0

# Force "Secure" flag on cookies; defaults to true in production, false otherwise
COOKIE_SECURE=

# Must never be true in production (enforced at startup)
RATE_LIMIT_DISABLED=false

# Private, non-publicly-served directory for generated documents (invoice PDFs, etc).
DOCUMENT_STORAGE_PATH=
